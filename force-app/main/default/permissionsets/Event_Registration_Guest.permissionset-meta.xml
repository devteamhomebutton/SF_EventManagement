<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Event Registration Guest</label>
    <description>Site guest access to the public registration and badge pages and their controllers. Grants no object or field permissions by design: both controllers run without sharing, so the guest can do only what those methods allow.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <classAccesses>
        <apexClass>BadgeScanService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>EventBadgeController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>EventRegisterController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>EventRegistrationService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <pageAccesses>
        <apexPage>EventBadge</apexPage>
        <enabled>true</enabled>
    </pageAccesses>
    <pageAccesses>
        <apexPage>EventRegister</apexPage>
        <enabled>true</enabled>
    </pageAccesses>
</PermissionSet>
