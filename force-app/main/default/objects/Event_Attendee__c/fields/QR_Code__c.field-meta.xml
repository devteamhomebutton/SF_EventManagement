<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>QR_Code__c</fullName>
    <description>Shows the badge QR image from the Attendee_QR_Codes static resource, matched on Badge Id (spaces become hyphens).</description>
    <externalId>false</externalId>
    <formula>IMAGE(&quot;/resource/Attendee_QR_Codes/&quot; &amp; SUBSTITUTE(Badge_Id__c, &quot; &quot;, &quot;-&quot;) &amp; &quot;.png&quot;, &quot;QR &quot; &amp; Badge_Id__c, 180, 180)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>QR Code</label>
    <required>false</required>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
